+def configure_npc_agent(agent, spawn_points):
+    """Enable continuous NPC navigation so they never stop."""
+    # NPC mode: ignore other NPC vehicles to prevent mutual deadlocks
+    agent._npc_mode = True
+
+    if not hasattr(agent, "get_local_planner"):
+        return
+    lp = agent.get_local_planner()
+    lp._auto_roam_on_empty = True
+
+    def _refill(local_planner):
+        """Called from inside run_step() when the waypoint queue is running low."""
+        plan = list(local_planner.get_plan())
+        if plan:
+            end_loc = plan[-1][0].transform.location
+            try:
+                print(
+                    "[DEST] NPC %d: refill callback extending route" % agent._vehicle.id
+                )
+                set_reachable_destination(agent, spawn_points, start_location=end_loc)
+                return
+            except Exception:
+                pass
+        # Fallback: route from current vehicle position
+        try:
+            print(
+                "[DEST] NPC %d: refill callback fallback from current position"
+                % agent._vehicle.id
+            )
+            set_reachable_destination(agent, spawn_points)
+        except Exception:
+            pass  # auto_roam_on_empty will keep the NPC moving
+
+    lp.set_plan_refill_callback(_refill)
+
