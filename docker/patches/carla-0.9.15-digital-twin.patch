+void UOpenDriveToMap::ImportXODR(){
+  IPlatformFile& FileManager = FPlatformFileManager::Get().GetPlatformFile();
+  FString FinalBaseDestinationPath = BaseDestinationPath.IsEmpty() ? "/Game/CustomMaps/" : BaseDestinationPath;
+  if (!FinalBaseDestinationPath.EndsWith("/")) FinalBaseDestinationPath += "/";
+  FString FinalBaseDir = FinalBaseDestinationPath.Replace(TEXT("/Game/"), *FPaths::ProjectContentDir());
+  FString DestinationDir = FinalBaseDir + MapName + "/OpenDrive/";
+  FString MyFileDestination = DestinationDir + MapName + ".xodr";
+  FString SourceXODR = LocalXODRFilePath.EndsWith(".xodr") ? LocalXODRFilePath : LocalFilePath;
+
+  if (!FileManager.DirectoryExists(*DestinationDir))
+  {
+    FileManager.CreateDirectoryTree(*DestinationDir);
+  }
+
+  if(FileManager.CopyFile(  *MyFileDestination, *SourceXODR,
+                              EPlatformFileRead::None,
+                              EPlatformFileWrite::None))
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Verbose, TEXT("FilePaths: File Copied!"));
+    FilePath = MyFileDestination;
+    LoadMap();
+  }
+  else
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("FilePaths local xodr file not copied: File not Copied!"));
+  }
+}
+
+void UOpenDriveToMap::ImportOSM(){
+  if (!StageLocalOSMToProject())
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("FilePaths local osm file not copied: File not Copied!"));
+    return;
+  }
+
+  ConvertOSMInOpenDrive();
+}
+
+bool UOpenDriveToMap::StageLocalOSMToProject()
+{
+  IPlatformFile& FileManager = FPlatformFileManager::Get().GetPlatformFile();
+  FString FinalBaseDestinationPath = BaseDestinationPath.IsEmpty() ? "/Game/CustomMaps/" : BaseDestinationPath;
+  if (!FinalBaseDestinationPath.EndsWith("/")) FinalBaseDestinationPath += "/";
+  FString FinalBaseDir = FinalBaseDestinationPath.Replace(TEXT("/Game/"), *FPaths::ProjectContentDir());
+  FString DestinationDir = FinalBaseDir + MapName + "/OpenDrive/";
+  FString MyFileDestination = DestinationDir + MapName + ".osm";
+  FString SourceOSM = LocalOSMFilePath.EndsWith(".osm") ? LocalOSMFilePath : LocalFilePath;
+
+  if (!FileManager.DirectoryExists(*DestinationDir))
+  {
+    FileManager.CreateDirectoryTree(*DestinationDir);
+  }
+
+  if(FileManager.CopyFile(  *MyFileDestination, *SourceOSM,
+                              EPlatformFileRead::None,
+                              EPlatformFileWrite::None))
+  {
+    LocalOSMFilePath = MyFileDestination;
+    UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("FilePaths: OSM staged at '%s'"), *LocalOSMFilePath);
+    return true;
+  }
+
+  return false;
+}
