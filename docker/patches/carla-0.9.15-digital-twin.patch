+    static constexpr double EXTERIOR_ROAD_MARK_WIDTH = 0.13;
+    static constexpr double BIDIRECTIONAL_CENTER_MARK_WIDTH = 0.13;
+    static constexpr double BIDIRECTIONAL_REFERENCE_MATCH_TOLERANCE = 2.0;
+    static constexpr double BIDIRECTIONAL_BROKEN_LINE_LENGTH = 3.0;
+    static constexpr double BIDIRECTIONAL_BROKEN_LINE_GAP = 6.0;
+    static constexpr double EXTERIOR_MARK_RASTER_MPP = 0.2;
+    static constexpr double EXTERIOR_MARK_SMOOTHING_M = 1.5;
+    static constexpr double EXTERIOR_MARK_MIN_POINT_SPACING_M = 0.3;
+
+    struct RasterPoint {
+      int x = 0;
+      int y = 0;
+
+      bool operator==(const RasterPoint &rhs) const {
+        return x == rhs.x && y == rhs.y;
+      }
+    };
+
+    struct RasterBounds {
+      double min_x = 0.0;
+      double min_y = 0.0;
+      double scale = EXTERIOR_MARK_RASTER_MPP;
+      int width = 0;
+      int height = 0;
+    };
+
+    static bool IsRoadSurfaceLaneType(const Lane::LaneType type) {
+      return type == Lane::LaneType::Driving ||
+             type == Lane::LaneType::Border ||
+             type == Lane::LaneType::Shoulder ||
+             type == Lane::LaneType::Parking ||
+             type == Lane::LaneType::Restricted;
+    }
+
+    static uint64_t PackRasterPoint(const RasterPoint &point) {
+      return (static_cast<uint64_t>(static_cast<uint32_t>(point.x)) << 32u) |
+             static_cast<uint32_t>(point.y);
+    }
+
+    static double Distance2D(const geom::Vector3D &lhs, const geom::Vector3D &rhs) {
+      const double dx = static_cast<double>(lhs.x) - static_cast<double>(rhs.x);
+      const double dy = static_cast<double>(lhs.y) - static_cast<double>(rhs.y);
+      return std::sqrt(dx * dx + dy * dy);
+    }
+
+    static bool AddLaneSurfacePolygon(
+        const Lane &lane,
+        const double s_start,
+        const double s_end,
+        const double sample_step,
+        std::vector<std::vector<geom::Vector3D>> &polygons,
+        double &min_x,
+        double &min_y,
+        double &max_x,
+        double &max_y) {
+      if (lane.GetId() == 0 || !IsRoadSurfaceLaneType(lane.GetType()) ||
+          s_end - s_start <= EPSILON) {
+        return false;
+      }
+
+      std::vector<geom::Vector3D> outer_points;
+      std::vector<geom::Vector3D> inner_points;
+      const double s_last = std::max(s_start, s_end - EPSILON);
+      double last_sample = -1.0;
+
+      auto add_sample = [&](const double s_value) {
+        const double s = std::max(s_start, std::min(s_value, s_last));
+        if (last_sample >= 0.0 && std::abs(s - last_sample) <= EPSILON) {
+          return;
+        }
+
+        const auto edges = lane.GetCornerPositions(s, 0.0f);
+        if (Distance2D(edges.first, edges.second) <= EPSILON) {
+          return;
+        }
+
+        const bool right_side_lane = lane.GetId() < 0;
+        const geom::Vector3D outer = right_side_lane ? edges.first : edges.second;
+        const geom::Vector3D inner = right_side_lane ? edges.second : edges.first;
+        outer_points.push_back(outer);
+        inner_points.push_back(inner);
+
+        min_x = std::min(min_x, static_cast<double>(outer.x));
+        min_y = std::min(min_y, static_cast<double>(outer.y));
+        max_x = std::max(max_x, static_cast<double>(outer.x));
+        max_y = std::max(max_y, static_cast<double>(outer.y));
+        min_x = std::min(min_x, static_cast<double>(inner.x));
+        min_y = std::min(min_y, static_cast<double>(inner.y));
+        max_x = std::max(max_x, static_cast<double>(inner.x));
+        max_y = std::max(max_y, static_cast<double>(inner.y));
+
+        last_sample = s;
+      };
+
+      for (double s = s_start; s < s_end; s += sample_step) {
+        add_sample(s);
+      }
+      add_sample(s_last);
+
+      if (outer_points.size() < 2u || inner_points.size() < 2u) {
+        return false;
+      }
+
+      std::vector<geom::Vector3D> polygon;
+      polygon.reserve(outer_points.size() + inner_points.size());
+      polygon.insert(polygon.end(), outer_points.begin(), outer_points.end());
+      polygon.insert(polygon.end(), inner_points.rbegin(), inner_points.rend());
+      polygons.push_back(std::move(polygon));
+      return true;
+    }
