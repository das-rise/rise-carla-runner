+def describe_spawn_point(index, spawn_point, description):
+    """Print a human-readable summary of a selected spawn point."""
+    location = spawn_point.location
+    rotation = spawn_point.rotation
+    print(
+        "%s spawn point [%d]: loc=(%.1f, %.1f, %.1f), yaw=%.1f"
+        % (
+            description,
+            index,
+            location.x,
+            location.y,
+            location.z,
+            rotation.yaw,
+        )
+    )
+
