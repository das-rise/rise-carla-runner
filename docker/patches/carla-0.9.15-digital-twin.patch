+    static std::vector<std::vector<geom::Vector3D>> CollectRoadSurfacePolygons(
+        const std::unordered_map<RoadId, Road> &roads,
+        const std::vector<RoadId> &road_ids,
+        const double sample_step,
+        RasterBounds &bounds) {
+      std::vector<std::vector<geom::Vector3D>> polygons;
+      double min_x = std::numeric_limits<double>::max();
+      double min_y = std::numeric_limits<double>::max();
+      double max_x = std::numeric_limits<double>::lowest();
+      double max_y = std::numeric_limits<double>::lowest();
+
+      for (const RoadId id : road_ids) {
+        const auto road_it = roads.find(id);
+        if (road_it == roads.end()) {
+          continue;
+        }
+        const auto &road = road_it->second;
+        for (auto &&lane_section : road.GetLaneSections()) {
+          const double s_start = lane_section.GetDistance();
+          const double s_end = lane_section.GetDistance() + lane_section.GetLength();
+          for (auto &&lane_pair : lane_section.GetLanes()) {
+            AddLaneSurfacePolygon(
+                lane_pair.second,
+                s_start,
+                s_end,
+                sample_step,
+                polygons,
+                min_x,
+                min_y,
+                max_x,
+                max_y);
+          }
+        }
+      }
+
+      if (polygons.empty() || min_x >= max_x || min_y >= max_y) {
+        bounds = RasterBounds();
+        return polygons;
+      }
+
+      double scale = EXTERIOR_MARK_RASTER_MPP;
+      const double margin = std::max(2.0, scale * 8.0);
+      min_x -= margin;
+      min_y -= margin;
+      max_x += margin;
+      max_y += margin;
+
+      int width = static_cast<int>((max_x - min_x) / scale) + 2;
+      int height = static_cast<int>((max_y - min_y) / scale) + 2;
+      if (width > 10000 || height > 10000) {
+        scale = std::max((max_x - min_x) / 9998.0, (max_y - min_y) / 9998.0);
+        width = static_cast<int>((max_x - min_x) / scale) + 2;
+        height = static_cast<int>((max_y - min_y) / scale) + 2;
+      }
+
+      bounds.min_x = min_x;
+      bounds.min_y = min_y;
+      bounds.scale = scale;
+      bounds.width = width;
+      bounds.height = height;
+      return polygons;
+    }
