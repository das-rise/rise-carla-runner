+      AddLaneBoundaryMarkPair(out_mesh, lane, s_end, mark_width, use_first_corner, has_previous_pair);
+      return out_mesh.GetIndexesNum() > index_count_before;
+    }
+
+    static bool AppendGeneratedLaneMark(
+        Mesh &out_mesh,
+        const road::Lane &lane,
+        const double s_start,
+        const double s_end,
+        const double sample_step,
+        const ResolvedLaneMarking &lane_marking,
+        const bool use_first_corner) {
+      if (lane_marking.type == road::element::LaneMarking::Type::Solid) {
+        return AppendGeneratedLaneBoundarySegment(
+            out_mesh, lane, s_start, s_end, sample_step, lane_marking.width, use_first_corner);
