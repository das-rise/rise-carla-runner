+FMeshDescription UMapGenFunctionLibrary::BuildMultiSectionMeshDescription(
+    const TArray<FProceduralCustomMesh>& SectionData,
+    const TArray<TArray<FProcMeshTangent>>& SectionTangents,
+    const TArray<UMaterialInstance*>& SectionMaterials)
+{
+  // Count totals across all sections
+  int32 TotalVertices = 0;
+  int32 TotalIndices = 0;
+  for (const auto& Data : SectionData)
+  {
+    TotalVertices += Data.Vertices.Num();
+    TotalIndices += Data.Triangles.Num();
+  }
+
+  FMeshDescription MeshDescription;
+  FStaticMeshAttributes AttributeGetter(MeshDescription);
+  AttributeGetter.Register();
+
+  TPolygonGroupAttributesRef<FName> PolygonGroupNames = AttributeGetter.GetPolygonGroupMaterialSlotNames();
+  TVertexAttributesRef<FVector> VertexPositions = AttributeGetter.GetVertexPositions();
+  TVertexInstanceAttributesRef<FVector> Tangents = AttributeGetter.GetVertexInstanceTangents();
+  TVertexInstanceAttributesRef<float> BinormalSigns = AttributeGetter.GetVertexInstanceBinormalSigns();
+  TVertexInstanceAttributesRef<FVector> Normals = AttributeGetter.GetVertexInstanceNormals();
+  TVertexInstanceAttributesRef<FVector4> Colors = AttributeGetter.GetVertexInstanceColors();
+  TVertexInstanceAttributesRef<FVector2D> UVs = AttributeGetter.GetVertexInstanceUVs();
+
+  MeshDescription.ReserveNewVertices(TotalVertices);
+  MeshDescription.ReserveNewVertexInstances(TotalIndices);
+  MeshDescription.ReserveNewPolygons(TotalIndices / 3);
+  MeshDescription.ReserveNewEdges(TotalIndices / 3 * 2);
+  UVs.SetNumIndices(4);
+
+  for (int32 SectionIdx = 0; SectionIdx < SectionData.Num(); ++SectionIdx)
+  {
+    const FProceduralCustomMesh& Data = SectionData[SectionIdx];
+    const TArray<FProcMeshTangent>& ParamTangents = SectionTangents[SectionIdx];
+    UMaterialInstance* Mat = SectionMaterials[SectionIdx];
+
+    FPolygonGroupID PolyGroup = MeshDescription.CreatePolygonGroup();
+    if (Mat)
+    {
+      PolygonGroupNames[PolyGroup] = Mat->GetFName();
+    }
+
+    // Create vertices for this section
+    TMap<int32, FVertexID> VertexIndexToVertexID;
+    VertexIndexToVertexID.Reserve(Data.Vertices.Num());
+    for (int32 VertexIndex = 0; VertexIndex < Data.Vertices.Num(); ++VertexIndex)
+    {
+      const FVertexID VertexID = MeshDescription.CreateVertex();
+      VertexPositions[VertexID] = Data.Vertices[VertexIndex];
+      VertexIndexToVertexID.Add(VertexIndex, VertexID);
+    }
+
+    // Create vertex instances from index buffer
+    TMap<int32, FVertexInstanceID> IndiceIndexToVertexInstanceID;
+    IndiceIndexToVertexInstanceID.Reserve(Data.Triangles.Num());
+    for (int32 IndiceIndex = 0; IndiceIndex < Data.Triangles.Num(); ++IndiceIndex)
+    {
+      const int32 VertexIndex = Data.Triangles[IndiceIndex];
+      const FVertexID VertexID = VertexIndexToVertexID[VertexIndex];
+      const FVertexInstanceID VertexInstanceID = MeshDescription.CreateVertexInstance(VertexID);
+      IndiceIndexToVertexInstanceID.Add(IndiceIndex, VertexInstanceID);
+
+      Normals[VertexInstanceID] = Data.Normals[VertexIndex];
+
+      if (ParamTangents.Num() == Data.Vertices.Num())
+      {
+        Tangents[VertexInstanceID] = ParamTangents[VertexIndex].TangentX;
+        BinormalSigns[VertexInstanceID] = ParamTangents[VertexIndex].bFlipTangentY ? -1.f : 1.f;
+      }
+
+      Colors[VertexInstanceID] = FLinearColor(0, 0, 0);
+
+      if (Data.UV0.Num() == Data.Vertices.Num())
+        UVs.Set(VertexInstanceID, 0, Data.UV0[VertexIndex]);
+      else
+        UVs.Set(VertexInstanceID, 0, FVector2D(0, 0));
+
+      UVs.Set(VertexInstanceID, 1, FVector2D(0, 0));
+      UVs.Set(VertexInstanceID, 2, FVector2D(0, 0));
+      UVs.Set(VertexInstanceID, 3, FVector2D(0, 0));
+    }
+
+    // Create polygons assigned to this section's polygon group
+    const int32 NumTri = Data.Triangles.Num() / 3;
+    for (int32 TriIdx = 0; TriIdx < NumTri; ++TriIdx)
+    {
+      TArray<FVertexInstanceID> VertexInstanceIDs;
+      VertexInstanceIDs.SetNum(3);
+      for (int32 Corner = 0; Corner < 3; ++Corner)
+      {
+        const int32 IndiceIndex = TriIdx * 3 + Corner;
+        VertexInstanceIDs[Corner] = IndiceIndexToVertexInstanceID[IndiceIndex];
+      }
+      MeshDescription.CreatePolygon(PolyGroup, VertexInstanceIDs);
+    }
+  }
+
+  return MeshDescription;
+}
+
+UStaticMesh* UMapGenFunctionLibrary::CreateMultiSectionMesh(
+    const TArray<FProceduralCustomMesh>& SectionData,
+    const TArray<TArray<FProcMeshTangent>>& SectionTangents,
+    const TArray<UMaterialInstance*>& SectionMaterials,
+    FString MapName,
+    FString FolderName,
+    FName MeshName,
+    FString BaseDestinationPath)
+{
+  IPlatformFile& PlatformFile = FPlatformFileManager::Get().GetPlatformFile();
+
+  if (BaseDestinationPath.IsEmpty())
+    BaseDestinationPath = "/Game/CustomMaps/";
+  if (!BaseDestinationPath.EndsWith("/"))
+    BaseDestinationPath += "/";
+
+  FString PackageName = BaseDestinationPath + MapName + "/Static/" + FolderName + "/" + MeshName.ToString();
+  FString OSPath = FPackageName::LongPackageNameToFilename(PackageName, FPackageName::GetAssetPackageExtension());
+  FString OSDir = FPaths::GetPath(OSPath);
+
+  if (!PlatformFile.DirectoryExists(*OSDir))
+    PlatformFile.CreateDirectoryTree(*OSDir);
+  if (PlatformFile.FileExists(*OSPath))
+  {
+    PlatformFile.SetReadOnly(*OSPath, false);
+    PlatformFile.DeleteFile(*OSPath);
+  }
+
+  FMeshDescription Description = BuildMultiSectionMeshDescription(SectionData, SectionTangents, SectionMaterials);
+
+  if (Description.Polygons().Num() > 0)
+  {
+#if WITH_EDITOR
+    UPackage* Package = CreatePackage(*PackageName);
+    check(Package);
+    UStaticMesh* Mesh = NewObject<UStaticMesh>(Package, MeshName, RF_Public | RF_Standalone);
+    Mesh->InitResources();
+    Mesh->LightingGuid = FGuid::NewGuid();
+
+    for (UMaterialInstance* Mat : SectionMaterials)
+    {
+      Mesh->StaticMaterials.Add(FStaticMaterial(Mat));
+    }
+
+    FStaticMeshSourceModel& SrcModel = Mesh->AddSourceModel();
+    SrcModel.BuildSettings.bRecomputeNormals = false;
+    SrcModel.BuildSettings.bRecomputeTangents = false;
+    SrcModel.BuildSettings.bRemoveDegenerates = false;
+    SrcModel.BuildSettings.bUseHighPrecisionTangentBasis = false;
+    SrcModel.BuildSettings.bUseFullPrecisionUVs = false;
+    SrcModel.BuildSettings.bGenerateLightmapUVs = true;
+    SrcModel.BuildSettings.SrcLightmapIndex = 0;
+    SrcModel.BuildSettings.DstLightmapIndex = 1;
+    Mesh->CreateMeshDescription(0, MoveTemp(Description));
+    Mesh->CommitMeshDescription(0);
+
+    Mesh->CreateBodySetup();
+    Mesh->BodySetup->CollisionTraceFlag = ECollisionTraceFlag::CTF_UseComplexAsSimple;
+    Mesh->BodySetup->CreatePhysicsMeshes();
+    Mesh->NeverStream = true;
+    Mesh->ImportVersion = EImportStaticMeshVersion::LastVersion;
+    Mesh->Build(false);
+    Mesh->PostEditChange();
+
+    FAssetRegistryModule::AssetCreated(Mesh);
+    Package->MarkPackageDirty();
+    if (!UPackage::SavePackage(Package,
+        Mesh,
+        EObjectFlags::RF_Public | EObjectFlags::RF_Standalone,
+        *OSPath,
+        GError,
+        nullptr,
+        true,
+        true,
+        SAVE_NoError))
+    {
+      UE_LOG(LogCarlaMapGenFunctionLibrary, Error,
+          TEXT("Failed to save generated multi-section mesh asset '%s' to '%s'"),
+          *MeshName.ToString(), *OSPath);
+    }
     return Mesh;
+#endif // WITH_EDITOR
   }
   return nullptr;
 }
