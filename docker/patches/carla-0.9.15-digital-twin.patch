+void FCarlaToolsModule::GenerateMapConsoleCommand(const TArray<FString>& Args)
+{
+  TMap<FString, FString> ParamsMap;
+  FString CombinedArgs = "";
+  for (const FString& Arg : Args)
+  {
+    CombinedArgs += " " + Arg;
+    FString Key, Value;
+    if (Arg.Split(TEXT("="), &Key, &Value))
+    {
+      if (Key.StartsWith(TEXT("-")))
+      {
+        Key.RemoveAt(0);
+      }
+      Value.TrimQuotesInline();
+      ParamsMap.Add(Key, Value);
+    }
+  }
+
+  auto GetParam = [&](const FString& Key) -> FString {
+    if (const FString* Val = ParamsMap.Find(Key)) return *Val;
+    return FString();
+  };
+
+  auto HasParam = [&](const FString& Key) -> bool {
+    return ParamsMap.Contains(Key);
+  };
+
+  // Scenario 1: Running in a terminal (unattended mode)
+  // We run in-process to capture logs in the same terminal and exit when done.
+  if (FApp::IsUnattended() || IsRunningCommandlet())
+  {
+    UE_LOG(LogCarlaTools, Log, TEXT("CarlaTools.GenerateMap: Unattended mode detected. Running in-process..."));
+
+    UClass* OpenDriveClass = StaticLoadClass(UOpenDriveToMap::StaticClass(), nullptr, TEXT("/CarlaTools/OnroadMapGenerator/BP_OpenDriveToMap.BP_OpenDriveToMap_C"));
+    if (!OpenDriveClass)
+    {
+      UE_LOG(LogCarlaTools, Error, TEXT("CarlaTools.GenerateMap: Could not load BP_OpenDriveToMap class."));
+      return;
+    }
+
+    UOpenDriveToMap* OpenDriveMap = NewObject<UOpenDriveToMap>(GetTransientPackage(), OpenDriveClass);
+    if (!OpenDriveMap)
+    {
+      UE_LOG(LogCarlaTools, Error, TEXT("CarlaTools.GenerateMap: Could not create OpenDriveToMap object."));
+      return;
+    }
+
+    // Populate properties
+    OpenDriveMap->MapName = GetParam("MapName");
+    if (OpenDriveMap->MapName.IsEmpty() && !GetParam("BaseLevelName").IsEmpty())
+    {
+        OpenDriveMap->MapName = FPaths::GetBaseFilename(GetParam("BaseLevelName"));
+    }
+
+    OpenDriveMap->LocalFilePath = GetParam("LocalFilePath");
+    OpenDriveMap->LocalOSMFilePath = GetParam("LocalOSMFilePath");
+    OpenDriveMap->LocalXODRFilePath = GetParam("LocalXODRFilePath");
+    OpenDriveMap->Url = GetParam("Url");
+    OpenDriveMap->BaseLevelName = GetParam("BaseLevelName");
+    OpenDriveMap->bForceOverwrite = HasParam("ForceOverwrite");
+    if (!OpenDriveMap->BaseLevelName.IsEmpty())
+    {
+      FString PathName = FPaths::GetPath(OpenDriveMap->BaseLevelName);
+      if (!PathName.EndsWith("/")) PathName += "/";
+      OpenDriveMap->BaseDestinationPath = PathName;
+    }
+
+    float GeoX = 0.0f;
+    float GeoY = 0.0f;
+    if (HasParam("GeoCoordsX")) GeoX = FCString::Atof(*GetParam("GeoCoordsX"));
+    if (HasParam("GeoCoordsY")) GeoY = FCString::Atof(*GetParam("GeoCoordsY"));
+    OpenDriveMap->OriginGeoCoordinates = FVector2D(GeoX, GeoY);
+
+    if (HasParam("GenerateSingleLevelMap"))
+    {
+      FString Val = GetParam("GenerateSingleLevelMap");
+      OpenDriveMap->bGenerateSingleLevelMap = Val.ToLower() != TEXT("false") && Val != TEXT("0");
+    }
+
+    if (HasParam("SingleLevelBoundsPadding"))
+    {
+      OpenDriveMap->SingleLevelBoundsPadding = FCString::Atof(*GetParam("SingleLevelBoundsPadding"));
+    }
+
+    if (HasParam("TerrainRoadBlendDistance"))
+    {
+      OpenDriveMap->TerrainRoadBlendDistance = FCString::Atof(*GetParam("TerrainRoadBlendDistance"));
+    }
+
+    if (HasParam("TerrainRoadClearance"))
+    {
+      OpenDriveMap->TerrainRoadClearance = FCString::Atof(*GetParam("TerrainRoadClearance"));
+    }
+
+    if (HasParam("PreferXODRWhenBothProvided"))
+    {
+      FString Val = GetParam("PreferXODRWhenBothProvided");
+      OpenDriveMap->bPreferXODRWhenBothProvided = Val.ToLower() != TEXT("false") && Val != TEXT("0");
+    }
+
+    if (HasParam("RedrawLaneMarkings") || HasParam("IgnoreXODRLaneMarkings"))
+    {
+      const FString Val = HasParam("RedrawLaneMarkings")
+          ? GetParam("RedrawLaneMarkings")
+          : GetParam("IgnoreXODRLaneMarkings");
+      OpenDriveMap->bRedrawLaneMarkings =
+          Val.IsEmpty() ||
+          (Val.ToLower() != TEXT("false") && Val != TEXT("0"));
+    }
+
+    if (HasParam("BidirectionalCenterLineMarking") ||
+        HasParam("BidirectionalCenterlineMarking") ||
+        HasParam("CenterLineMarking") ||
+        HasParam("CenterlineMarking"))
+    {
+      if (HasParam("BidirectionalCenterLineMarking"))
+      {
+        OpenDriveMap->BidirectionalCenterLineMarking = GetParam("BidirectionalCenterLineMarking");
+      }
+      else if (HasParam("BidirectionalCenterlineMarking"))
+      {
+        OpenDriveMap->BidirectionalCenterLineMarking = GetParam("BidirectionalCenterlineMarking");
+      }
+      else if (HasParam("CenterLineMarking"))
+      {
+        OpenDriveMap->BidirectionalCenterLineMarking = GetParam("CenterLineMarking");
+      }
+      else
+      {
+        OpenDriveMap->BidirectionalCenterLineMarking = GetParam("CenterlineMarking");
+      }
+    }
+
+    UE_LOG(LogCarlaTools, Log, TEXT("CarlaTools.GenerateMap: Starting generation..."));
+    OpenDriveMap->CreateMap();
+    UE_LOG(LogCarlaTools, Log, TEXT("CarlaTools.GenerateMap: Generation finished. Requesting exit."));
+
+    FGenericPlatformMisc::RequestExit(false);
+  }
+  else
+  {
+    // Scenario 2: Running in Editor GUI
+    // Launch a standalone process in a terminal window to keep the editor responsive.
+    FString ExecutablePath = FPlatformProcess::ExecutablePath();
+    FString ProjectPath = FPaths::ConvertRelativePathToFull(FPaths::GetProjectFilePath());
+
+    // Build the script content
+    FString ScriptContent = FString::Printf(
+        TEXT("#!/bin/bash\n\"%s\" \"%s\" -run=GenerateTileCommandlet %s -nullrhi -nosplash -stdout -unattended\n"),
+        *ExecutablePath, *ProjectPath, *CombinedArgs);
+
+    FString ScriptPath = TEXT("/tmp/carla_generate_map.sh");
+    if (FFileHelper::SaveStringToFile(ScriptContent, *ScriptPath))
+    {
+        // Make the script executable
+        FPlatformProcess::CreateProc(TEXT("/bin/chmod"), TEXT("+x /tmp/carla_generate_map.sh"), true, true, true, nullptr, 0, nullptr, nullptr, nullptr);
+
