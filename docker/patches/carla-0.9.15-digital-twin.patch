+    static bool IsInsideRaster(
+        const int x,
+        const int y,
+        const RasterBounds &bounds) {
+      return x >= 0 && y >= 0 && x < bounds.width && y < bounds.height;
+    }
+
+    static void FillRasterPolygon(
+        const std::vector<geom::Vector3D> &polygon,
+        const RasterBounds &bounds,
+        std::vector<uint8_t> &mask) {
+      if (polygon.size() < 3u || bounds.width <= 1 || bounds.height <= 1) {
+        return;
+      }
+
+      std::vector<std::pair<double, double>> points;
+      points.reserve(polygon.size());
+      double min_py = std::numeric_limits<double>::max();
+      double max_py = std::numeric_limits<double>::lowest();
+      for (const auto &point : polygon) {
+        const double px = (static_cast<double>(point.x) - bounds.min_x) / bounds.scale;
+        const double py = (static_cast<double>(point.y) - bounds.min_y) / bounds.scale;
+        points.emplace_back(px, py);
+        min_py = std::min(min_py, py);
+        max_py = std::max(max_py, py);
+      }
+
+      const int y_start = std::max(0, static_cast<int>(std::floor(min_py)));
+      const int y_end = std::min(bounds.height - 1, static_cast<int>(std::ceil(max_py)));
+      std::vector<double> intersections;
+      for (int y = y_start; y <= y_end; ++y) {
+        const double scan_y = static_cast<double>(y) + 0.5;
+        intersections.clear();
+        for (size_t i = 0u, j = points.size() - 1u; i < points.size(); j = i++) {
+          const double yi = points[i].second;
+          const double yj = points[j].second;
+          if ((yi > scan_y) == (yj > scan_y)) {
+            continue;
+          }
+          const double xi = points[i].first;
+          const double xj = points[j].first;
+          const double x = xi + (scan_y - yi) * (xj - xi) / (yj - yi);
+          intersections.push_back(x);
+        }
+
+        std::sort(intersections.begin(), intersections.end());
+        for (size_t i = 0u; i + 1u < intersections.size(); i += 2u) {
+          const int x_start = std::max(0, static_cast<int>(std::ceil(intersections[i])));
+          const int x_end = std::min(bounds.width - 1, static_cast<int>(std::floor(intersections[i + 1u])));
+          for (int x = x_start; x <= x_end; ++x) {
+            mask[static_cast<size_t>(y) * static_cast<size_t>(bounds.width) +
+                 static_cast<size_t>(x)] = 1u;
+          }
+        }
+      }
+    }
+
+    static std::vector<geom::Vector3D> SmoothAndThinClosedPolyline(
+        const std::vector<RasterPoint> &loop,
+        const RasterBounds &bounds) {
+      std::vector<geom::Vector3D> points;
+      if (loop.size() < 4u) {
+        return points;
+      }
+
+      std::vector<geom::Vector3D> raw_points;
+      raw_points.reserve(loop.size());
+      for (const auto &point : loop) {
+        raw_points.emplace_back(
+            static_cast<float>(static_cast<double>(point.x) * bounds.scale + bounds.min_x),
+            static_cast<float>(static_cast<double>(point.y) * bounds.scale + bounds.min_y),
+            0.0f);
+      }
+
+      int smooth_window = static_cast<int>(EXTERIOR_MARK_SMOOTHING_M / bounds.scale);
+      smooth_window = std::max(5, smooth_window | 1);
+      const int half_window = smooth_window / 2;
+      std::vector<geom::Vector3D> smoothed;
+      smoothed.reserve(raw_points.size());
+      for (size_t i = 0u; i < raw_points.size(); ++i) {
+        double sum_x = 0.0;
+        double sum_y = 0.0;
+        for (int offset = -half_window; offset <= half_window; ++offset) {
+          const int raw_index = static_cast<int>(i) + offset;
+          const size_t wrapped_index =
+              static_cast<size_t>((raw_index % static_cast<int>(raw_points.size()) +
+                                   static_cast<int>(raw_points.size())) %
+                                  static_cast<int>(raw_points.size()));
+          sum_x += raw_points[wrapped_index].x;
+          sum_y += raw_points[wrapped_index].y;
+        }
+        smoothed.emplace_back(
+            static_cast<float>(sum_x / smooth_window),
+            static_cast<float>(sum_y / smooth_window),
+            0.0f);
+      }
+
+      for (const auto &point : smoothed) {
+        if (points.empty() ||
+            Distance2D(points.back(), point) >= EXTERIOR_MARK_MIN_POINT_SPACING_M) {
+          points.push_back(point);
+        }
+      }
+      if (points.size() > 2u &&
+          Distance2D(points.front(), points.back()) < EXTERIOR_MARK_MIN_POINT_SPACING_M) {
+        points.pop_back();
+      }
+      return points;
+    }
+
+    static std::vector<std::vector<geom::Vector3D>> ExtractRasterContours(
+        const std::vector<uint8_t> &mask,
+        const RasterBounds &bounds) {
+      std::unordered_map<uint64_t, std::vector<RasterPoint>> edge_map;
+      auto is_filled = [&](const int x, const int y) {
+        return IsInsideRaster(x, y, bounds) &&
+               mask[static_cast<size_t>(y) * static_cast<size_t>(bounds.width) +
+                    static_cast<size_t>(x)] != 0u;
+      };
+      auto add_edge = [&](const RasterPoint &from, const RasterPoint &to) {
+        edge_map[PackRasterPoint(from)].push_back(to);
+      };
+
+      for (int y = 0; y < bounds.height; ++y) {
+        for (int x = 0; x < bounds.width; ++x) {
+          if (!is_filled(x, y)) {
+            continue;
+          }
+          if (!is_filled(x, y - 1)) {
+            add_edge({x, y}, {x + 1, y});
+          }
+          if (!is_filled(x + 1, y)) {
+            add_edge({x + 1, y}, {x + 1, y + 1});
+          }
+          if (!is_filled(x, y + 1)) {
+            add_edge({x + 1, y + 1}, {x, y + 1});
+          }
+          if (!is_filled(x - 1, y)) {
+            add_edge({x, y + 1}, {x, y});
+          }
+        }
+      }
+
+      std::vector<std::vector<geom::Vector3D>> contours;
+      while (!edge_map.empty()) {
+        auto start_it = edge_map.end();
+        for (auto it = edge_map.begin(); it != edge_map.end(); ++it) {
+          if (!it->second.empty()) {
+            start_it = it;
+            break;
+          }
+        }
+        if (start_it == edge_map.end()) {
+          break;
+        }
+
+        const RasterPoint start{
+            static_cast<int>(start_it->first >> 32u),
+            static_cast<int>(start_it->first & 0xffffffffu)};
+        RasterPoint current = start;
+        std::vector<RasterPoint> loop;
+
+        const size_t max_steps = edge_map.size() + 4u;
+        for (size_t step = 0u; step < max_steps; ++step) {
+          loop.push_back(current);
+          auto edge_it = edge_map.find(PackRasterPoint(current));
+          if (edge_it == edge_map.end() || edge_it->second.empty()) {
+            break;
+          }
+          const RasterPoint next = edge_it->second.back();
+          edge_it->second.pop_back();
+          if (edge_it->second.empty()) {
+            edge_map.erase(edge_it);
+          }
+          current = next;
+          if (current == start) {
+            break;
+          }
+        }
+
+        if (loop.size() >= 4u && current == start) {
+          auto contour = SmoothAndThinClosedPolyline(loop, bounds);
+          if (contour.size() >= 3u) {
+            contours.push_back(std::move(contour));
+          }
+        }
+      }
+      return contours;
+    }
+
+    static std::unique_ptr<geom::Mesh> BuildClosedContourMarkMesh(
+        const std::vector<geom::Vector3D> &contour,
+        const double mark_width) {
+      auto mesh = std::make_unique<geom::Mesh>();
+      if (contour.size() < 3u) {
+        return mesh;
+      }
+
+      const float half_width = static_cast<float>(mark_width * 0.5);
+      for (size_t i = 0u; i < contour.size(); ++i) {
+        const geom::Vector3D &previous =
+            contour[(i + contour.size() - 1u) % contour.size()];
+        const geom::Vector3D &next = contour[(i + 1u) % contour.size()];
+        geom::Vector3D tangent = next - previous;
+        const double tangent_length = tangent.Length2D();
+        if (tangent_length <= EPSILON) {
+          tangent = geom::Vector3D(1.0f, 0.0f, 0.0f);
+        } else {
+          tangent /= tangent_length;
+        }
+
+        const geom::Vector3D normal(-tangent.y, tangent.x, 0.0f);
+        mesh->AddVertex(contour[i] + normal * half_width);
+        mesh->AddVertex(contour[i] - normal * half_width);
+      }
+
+      for (size_t i = 0u; i < contour.size(); ++i) {
+        const size_t next = (i + 1u) % contour.size();
+        const size_t outer_current = i * 2u + 1u;
+        const size_t inner_current = i * 2u + 2u;
+        const size_t outer_next = next * 2u + 1u;
+        const size_t inner_next = next * 2u + 2u;
+
+        mesh->AddIndex(outer_current);
+        mesh->AddIndex(inner_current);
+        mesh->AddIndex(outer_next);
+        mesh->AddIndex(inner_current);
+        mesh->AddIndex(inner_next);
+        mesh->AddIndex(outer_next);
+      }
+      return mesh;
+    }
+
+    static std::unique_ptr<geom::Mesh> BuildOpenPolylineMarkMesh(
+        const std::vector<geom::Vector3D> &points,
+        const double mark_width) {
+      auto mesh = std::make_unique<geom::Mesh>();
+      if (points.size() < 2u) {
+        return mesh;
+      }
+
+      const float half_width = static_cast<float>(mark_width * 0.5);
+      for (size_t i = 0u; i < points.size(); ++i) {
+        const geom::Vector3D &previous = i == 0u ? points[i] : points[i - 1u];
+        const geom::Vector3D &next = i + 1u < points.size() ? points[i + 1u] : points[i];
+        geom::Vector3D tangent = next - previous;
+        const double tangent_length = tangent.Length2D();
+        if (tangent_length <= EPSILON) {
+          tangent = geom::Vector3D(1.0f, 0.0f, 0.0f);
+        } else {
+          tangent /= tangent_length;
+        }
+
+        const geom::Vector3D normal(-tangent.y, tangent.x, 0.0f);
+        mesh->AddVertex(points[i] + normal * half_width);
+        mesh->AddVertex(points[i] - normal * half_width);
+      }
+
+      for (size_t i = 0u; i + 1u < points.size(); ++i) {
+        const size_t outer_current = i * 2u + 1u;
+        const size_t inner_current = i * 2u + 2u;
+        const size_t outer_next = (i + 1u) * 2u + 1u;
+        const size_t inner_next = (i + 1u) * 2u + 2u;
+
+        mesh->AddIndex(outer_current);
+        mesh->AddIndex(inner_current);
+        mesh->AddIndex(outer_next);
+        mesh->AddIndex(inner_current);
+        mesh->AddIndex(inner_next);
+        mesh->AddIndex(outer_next);
+      }
+      return mesh;
+    }
+
+    static geom::Vector3D GetRoadReferencePoint(
+        const Road &road,
+        const double s) {
+      geom::Vector3D point =
+          road.GetDirectedPointIn(std::max(0.0, std::min(s, road.GetLength()))).location;
+      // Lane mesh generation flips OpenDRIVE Y into CARLA/Unreal space; keep
+      // topology-generated centerline markings in that same coordinate frame.
+      point.y *= -1.0f;
+      return point;
+    }
+
+    static bool IsSingleSurfaceLaneRoad(const Road &road) {
+      for (auto &&lane_section : road.GetLaneSections()) {
+        size_t surface_lane_count = 0u;
+        for (auto &&lane_pair : lane_section.GetLanes()) {
+          if (lane_pair.first != 0 &&
+              IsRoadSurfaceLaneType(lane_pair.second.GetType())) {
+            ++surface_lane_count;
+          }
+        }
+        if (surface_lane_count != 1u) {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    static bool IsOppositeUndividedRoadPair(
+        const Road &road,
+        const Road &candidate) {
+      if (road.GetId() == candidate.GetId() ||
+          road.IsJunction() ||
+          candidate.IsJunction() ||
+          !IsSingleSurfaceLaneRoad(road) ||
+          !IsSingleSurfaceLaneRoad(candidate)) {
+        return false;
+      }
+
+      const double length = road.GetLength();
+      const double candidate_length = candidate.GetLength();
+      if (length <= EPSILON || candidate_length <= EPSILON) {
+        return false;
+      }
+
+      const double length_tolerance = std::max(2.0, std::max(length, candidate_length) * 0.03);
+      if (std::abs(length - candidate_length) > length_tolerance) {
+        return false;
+      }
+
+      const double fractions[] = {0.0, 0.25, 0.5, 0.75, 1.0};
+      for (const double fraction : fractions) {
+        const double road_s = std::min(length - EPSILON, std::max(EPSILON, length * fraction));
+        const double candidate_s = std::min(
+            candidate_length - EPSILON,
+            std::max(EPSILON, candidate_length * (1.0 - fraction)));
+        if (Distance2D(
+                GetRoadReferencePoint(road, road_s),
+                GetRoadReferencePoint(candidate, candidate_s)) >
+            BIDIRECTIONAL_REFERENCE_MATCH_TOLERANCE) {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    static std::vector<geom::Vector3D> SampleRoadReferenceLineRange(
+        const Road &road,
+        const double s_start,
+        const double s_end,
+        const double sample_step) {
+      std::vector<geom::Vector3D> points;
+      const double length = road.GetLength();
+      if (length <= EPSILON) {
+        return points;
+      }
+
+      const double clamped_start = std::min(length - EPSILON, std::max(EPSILON, s_start));
+      const double clamped_end = std::min(length - EPSILON, std::max(EPSILON, s_end));
+      if (clamped_end - clamped_start <= EPSILON) {
+        return points;
+      }
+
+      double last_s = -1.0;
+      auto add_sample = [&](const double s_value) {
+        const double s = std::min(clamped_end, std::max(clamped_start, s_value));
+        if (last_s >= 0.0 && std::abs(s - last_s) <= EPSILON) {
+          return;
+        }
+        geom::Vector3D point = GetRoadReferencePoint(road, s);
+        if (points.empty() ||
+            Distance2D(points.back(), point) >= EXTERIOR_MARK_MIN_POINT_SPACING_M) {
+          points.push_back(point);
+        }
+        last_s = s;
+      };
+
+      for (double s = clamped_start; s < clamped_end; s += sample_step) {
+        add_sample(s);
+      }
+      add_sample(clamped_end);
+      return points;
+    }
+
+    static std::vector<geom::Vector3D> SampleRoadReferenceLine(
+        const Road &road,
+        const double sample_step) {
+      return SampleRoadReferenceLineRange(
+          road,
+          EPSILON,
+          road.GetLength() - EPSILON,
+          sample_step);
+    }
+
+    static void AppendBidirectionalCenterLineMarkings(
+        const std::unordered_map<RoadId, Road> &roads,
+        const std::vector<RoadId> &road_ids,
+        const double sample_step,
+        const int centerline_style,
+        std::vector<std::unique_ptr<geom::Mesh>> &line_marks,
+        std::vector<std::string> &outinfo) {
