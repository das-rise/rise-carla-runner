+def parse_transform_arg(value, description):
+    """Parse a CLI transform value formatted as x,y,z,yaw with x,y,z in cm."""
+    parts = [part.strip() for part in value.split(",")]
+    if len(parts) != 4:
+        raise ValueError("%s transform must be formatted as x,y,z,yaw" % description)
+    try:
+        x, y, z, yaw = [float(part) for part in parts]
+    except ValueError:
+        raise ValueError("%s transform values must be numeric: x,y,z,yaw" % description)
+    return carla.Transform(
+        carla.Location(x=x / 100.0, y=y / 100.0, z=z / 100.0),
+        carla.Rotation(yaw=yaw),
+    )
+
