+def create_navigation_agent(sim_world, vehicle, agent_name, behavior_name):
+    """Create a navigation agent for a vehicle using the requested policy."""
+    if agent_name == "Basic":
+        agent = BasicAgent(vehicle, 30)
+        agent.follow_speed_limits(True)
+        return agent
+    if agent_name == "Constant":
+        agent = ConstantVelocityAgent(vehicle, 30)
+        ground_loc = sim_world.ground_projection(vehicle.get_location(), 5)
+        if ground_loc:
+            vehicle.set_location(ground_loc.location + carla.Location(z=0.01))
+        agent.follow_speed_limits(True)
+        return agent
+    if agent_name == "Behavior":
+        return BehaviorAgent(vehicle, behavior=behavior_name)
+    raise ValueError("Unsupported agent type: %s" % agent_name)
+
+
+def destroy_navigation_agent(agent):
+    """Release any resources owned by a Python-side navigation agent."""
+    if isinstance(agent, ConstantVelocityAgent):
+        agent.destroy_sensor()
+
+
+def set_reachable_destination(agent, spawn_points):
+    """
+    Try spawn points in a random order until a routable destination is found.
+    Needed for maps with disconnected road network components.
+    """
+    import random as py_random
+
+    shuffled = list(spawn_points)
+    py_random.shuffle(shuffled)
+    for sp in shuffled:
+        try:
+            agent.set_destination(sp.location)
+            return sp.location
+        except nx.NetworkXNoPath:
+            continue
+    raise RuntimeError(
+        "No reachable destination found from current spawn point. "
+        "The map may have entirely disconnected road segments."
+    )
+
+
+def assign_agent_destination(agent, spawn_points, actor_label):
+    """Assign a random reachable destination to an agent-driven actor."""
+    try:
+        return set_reachable_destination(agent, spawn_points)
+    except RuntimeError as error:
+        logging.warning("Could not assign destination to %s: %s", actor_label, error)
+        return None
+
+
+def has_reached_location(actor, target_location, threshold_m=2.0):
+    """Check whether an actor is within a distance threshold of a target location."""
+    return actor.get_location().distance(target_location) <= threshold_m
