+void UOpenDriveToMap::PurgeGeneratedStaticDirectory(const FString& FinalBaseDestinationPath)
+{
+  if (MapName.IsEmpty())
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Warning,
+        TEXT("PurgeGeneratedStaticDirectory: MapName is empty; skipping Static/ cleanup."));
+    return;
+  }
+
+  FString DestinationPath = FinalBaseDestinationPath.IsEmpty()
+      ? FString(TEXT("/Game/CustomMaps/"))
+      : FinalBaseDestinationPath;
+  if (!DestinationPath.EndsWith(TEXT("/")))
+  {
+    DestinationPath += TEXT("/");
+  }
+
+  IPlatformFile& PlatformFile = FPlatformFileManager::Get().GetPlatformFile();
+  const FString StaticDir = FPackageName::LongPackageNameToFilename(
+      DestinationPath + MapName + TEXT("/Static"));
+  if (PlatformFile.DirectoryExists(*StaticDir))
+  {
+    PlatformFile.DeleteDirectoryRecursively(*StaticDir);
+    PlatformFile.CreateDirectoryTree(*StaticDir);
+    UE_LOG(LogCarlaToolsMapGenerator, Log,
+        TEXT("Purged generated Static/ directory at '%s'."), *StaticDir);
   }
 }
 
