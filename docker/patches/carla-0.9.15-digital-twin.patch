+        const double mark_width,
+        const bool use_first_corner,
+        const bool connect_to_previous_pair) {
+      const auto edges = lane.GetCornerPositions(s, 0.0f);
+      const geom::Vector3D boundary = use_first_corner ? edges.first : edges.second;
+      const geom::Vector3D opposite = use_first_corner ? edges.second : edges.first;
+      geom::Vector3D director = opposite - boundary;
