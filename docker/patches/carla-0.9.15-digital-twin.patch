+    static void AddMarkPair(
+        Mesh &out_mesh,
+        const geom::Vector3D &left,
+        const geom::Vector3D &right,
+        const bool connect_to_previous_pair) {
+      const size_t current_index = out_mesh.GetVertices().size() + 1;
+      out_mesh.AddVertex(left);
+      out_mesh.AddVertex(right);
