+      const size_t index_count_before = out_mesh.GetIndexesNum();
+      bool has_previous_pair = false;
+      for (double s_current = s_start; s_current < s_end; s_current += sample_step) {
+        if (AddLaneBoundaryMarkPair(
+                out_mesh, lane, s_current, mark_width, use_first_corner, has_previous_pair)) {
+          has_previous_pair = true;
