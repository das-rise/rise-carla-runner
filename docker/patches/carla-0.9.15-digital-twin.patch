+bool UOpenDriveToMap::UnloadTargetMapForOverwrite(const FString& MapPackageName)
+{
+  UWorld* CurrentWorld = UEditorLevelLibrary::GetEditorWorld();
+  if (CurrentWorld == nullptr)
+  {
+    return true;
+  }
+
+  const FString CurrentPackageName = CurrentWorld->GetOutermost()->GetName();
+  if (!CurrentPackageName.Equals(MapPackageName, ESearchCase::IgnoreCase))
+  {
+    return true;
+  }
+
+  UE_LOG(LogCarlaToolsMapGenerator, Log,
+      TEXT("ForceOverwrite: target map '%s' is currently loaded; opening a blank map before deleting generated assets."),
+      *MapPackageName);
+
+  UWorld* BlankWorld = UEditorLoadingAndSavingUtils::NewBlankMap(false);
+  if (BlankWorld == nullptr)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Warning,
+        TEXT("ForceOverwrite: failed to open a blank map before overwriting '%s'."),
+        *MapPackageName);
+    return false;
+  }
+
+  CollectGarbage(GARBAGE_COLLECTION_KEEPFLAGS);
+
+  UPackage* TargetPackage = FindPackage(nullptr, *MapPackageName);
+  if (TargetPackage != nullptr)
+  {
+    FText UnloadError;
+    if (!FEditorFileUtils::AttemptUnloadInactiveWorldPackage(TargetPackage, UnloadError))
+    {
+      UE_LOG(LogCarlaToolsMapGenerator, Warning,
+          TEXT("ForceOverwrite: target package '%s' is no longer the editor world but could not be fully unloaded: %s"),
+          *MapPackageName,
+          *UnloadError.ToString());
+      return false;
+    }
+  }
+
+  return true;
+}
