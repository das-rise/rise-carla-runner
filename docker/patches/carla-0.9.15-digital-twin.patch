+void UOpenDriveToMap::GenerateStreetMapActor(UStreetMap* StreetMap, FVector MinLocation)
+{
+  if (!StreetMap)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateStreetMapActor: null StreetMap"));
+    return;
+  }
+
+  UWorld* World = UEditorLevelLibrary::GetEditorWorld();
+  if (!World)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateStreetMapActor: no editor world"));
+    return;
+  }
+
+  TArray<AActor*> ExistingStreetMapActors;
+  UGameplayStatics::GetAllActorsOfClass(World, AStreetMapActor::StaticClass(), ExistingStreetMapActors);
+  for (AActor* ExistingActor : ExistingStreetMapActors)
+  {
+    if (ExistingActor)
+    {
+      World->EditorDestroyActor(ExistingActor, /*bShouldModifyLevel=*/true);
+    }
+  }
+
+  FActorSpawnParameters SpawnParams;
+  SpawnParams.bNoFail = true;
+  SpawnParams.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+
+  // Spawn at the waypoint-derived MinLocation: (min_Easting_cm, min_-Northing_cm).
+  // This is computed from ALL XODR waypoints so it covers the full map extent and
+  // matches the road network placement in Unreal world space.
+  AStreetMapActor* StreetMapActor = World->SpawnActor<AStreetMapActor>(
+      AStreetMapActor::StaticClass(),
+      FVector(MinLocation.X, MinLocation.Y, 0.0f),
+      FRotator::ZeroRotator,
+      SpawnParams);
+
+  if (!StreetMapActor)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateStreetMapActor: failed to spawn actor"));
+    return;
+  }
+
+  StreetMapActor->SetActorLabel(FString::Printf(TEXT("StreetMap_%s"), *MapName));
+  StreetMapActor->SetActorEnableCollision(false);
+
+  UStreetMapComponent* StreetMapComponent = StreetMapActor->GetStreetMapComponent();
+  if (!StreetMapComponent)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateStreetMapActor: spawned actor has no component"));
+    return;
+  }
+
+  StreetMapComponent->SetStreetMap(StreetMap, true, false);
+  StreetMapComponent->BuildMesh();
+
+  UE_LOG(LogCarlaToolsMapGenerator, Log,
+      TEXT("GenerateStreetMapActor: spawned '%s' at (%f, %f, %f) with MinLocation=(%f, %f, %f)"),
+      *StreetMapActor->GetActorLabel(),
+      StreetMapActor->GetActorLocation().X,
+      StreetMapActor->GetActorLocation().Y,
+      StreetMapActor->GetActorLocation().Z,
+      MinLocation.X,
+      MinLocation.Y,
+      MinLocation.Z);
+}
