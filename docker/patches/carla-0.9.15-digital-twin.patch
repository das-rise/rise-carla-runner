+def maybe_refresh_npc_destination(
+    npc_state,
+    sim_world,
+    args,
+    spawn_points,
+    min_plan_length=120,
+    min_replan_interval=1.0,
+):
+    """
+    Refresh an NPC's mission target before it reaches the current one so the
+    route changes while the actor is still moving.  Never destroys/rebuilds
+    the agent — the PID controller state is preserved for smooth motion.
+    """
+    npc = npc_state["vehicle"]
+    npc_agent = npc_state["agent"]
+    if not hasattr(npc_agent, "get_local_planner"):
+        return False
+
+    sim_time = sim_world.get_snapshot().timestamp.elapsed_seconds
+    last_refresh_time = npc_state.get("last_refresh_time")
+    if (
+        last_refresh_time is not None
+        and sim_time - last_refresh_time < min_replan_interval
+    ):
+        return False
+
+    local_planner = npc_agent.get_local_planner()
+    plan = local_planner.get_plan()
+
+    if len(plan) == 0:
+        # Plan is empty — set a new destination on the *existing* agent
+        # so the PID state is preserved and the NPC doesn't jerk.
+        try:
+            print("[DEST] NPC %d: plan empty, assigning recovery destination" % npc.id)
+            new_target_location = set_reachable_destination(npc_agent, spawn_points)
+            npc_state["target_location"] = new_target_location
+            npc_state["last_refresh_time"] = sim_time
+            return True
+        except Exception:
+            # auto_roam_on_empty keeps the NPC moving; retry next interval
+            npc_state["last_refresh_time"] = sim_time
+            return False
+
+    plan_end_location = plan[-1][0].transform.location
+    npc_state["target_location"] = plan_end_location
+
+    if len(plan) > min_plan_length:
+        return False
+
+    # Proactively extend the route before it runs out
+    try:
+        print(
+            "[DEST] NPC %d: proactive route extension (plan_len=%d)"
+            % (npc.id, len(plan))
+        )
+        new_target_location = set_reachable_destination(
+            npc_agent, spawn_points, start_location=plan_end_location
+        )
+        npc_state["target_location"] = new_target_location
+        npc_state["last_refresh_time"] = sim_time
+        return True
+    except Exception:
+        # Will retry after min_replan_interval; auto_roam covers the gap
+        npc_state["last_refresh_time"] = sim_time
