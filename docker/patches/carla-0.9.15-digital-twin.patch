+void UOpenDriveToMap::GenerateRoadMesh( const boost::optional<::carla::road::Map>& ParamCarlaMap, FVector MinLocation, FVector MaxLocation )
+{
+  opg_parameters.vertex_distance = 0.25f;
+  opg_parameters.additional_width = 0.0f;
+  opg_parameters.vertex_width_resolution = 8.0f;
+  opg_parameters.simplification_percentage = 0.0f;
+  double start = FPlatformTime::Seconds();
+
+  ::carla::geom::Vector3D CarlaMinLocation(MinLocation.X / 100, MaxLocation.Y / 100, MinLocation.Z /100);
+  ::carla::geom::Vector3D CarlaMaxLocation(MaxLocation.X / 100, MinLocation.Y / 100, MaxLocation.Z /100);
