+    }
+    else
+    {
+        UE_LOG(LogCarlaTools, Error, TEXT("CarlaTools.GenerateMap: Could not create temporary script at %s"), *ScriptPath);
+    }
+
+    UE_LOG(LogCarlaTools, Log, TEXT("CarlaTools.GenerateMap: Standalone process started. The editor remains responsive."));
+  }
