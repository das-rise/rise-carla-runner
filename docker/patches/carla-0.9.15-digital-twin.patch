+void UOpenDriveToMap::GenerateBuildingsFromOSM(UStreetMap* StreetMap, FVector MinLocation, FVector MaxLocation)
+{
+  if (!StreetMap)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateBuildingsFromOSM: null StreetMap"));
+    return;
+  }
+
+  const TArray<FStreetMapBuilding>& Buildings = StreetMap->GetBuildings();
+  UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("Generating %d buildings from OSM"), Buildings.Num());
+
+  if (Buildings.Num() == 0)
+  {
+    return;
+  }
+
+  UWorld* World = UEditorLevelLibrary::GetEditorWorld();
+  static int BuildingIndex = 0;
+  int32 GeneratedBuildingCount = 0;
+  int32 SkippedForestCount = 0;
+
+  for (const FStreetMapBuilding& Building : Buildings)
+  {
+    if (Building.BuildingCategory.Equals(TEXT("Forest"), ESearchCase::IgnoreCase))
+    {
+      ++SkippedForestCount;
+      continue;
+    }
+
+    const int32 NumPoints = Building.BuildingPoints.Num();
+    if (NumPoints < 3)
+    {
+      continue;
+    }
+
+    // ----------------------------------------------------------------
+    // Coordinate system (matches CARLA road vertices after y*=-1 hack):
+    //   StreetMap.X = Easting_cm  (positive east)  → Unreal X
+    //   StreetMap.Y = -Northing_cm (negative north) → Unreal Y
+    //   GetHeight(PosX, PosY): PosX = Easting_m, PosY = -Northing_m
+    // No swap needed — StreetMap already matches CARLA road geometry convention.
+    // ----------------------------------------------------------------
+
+    // 1. Convert to world coordinates (still in cm).
+    //    StreetMap coords are already relative to LatLonOrigin (same reference
+    //    as the XODR road geometry). Do NOT add FalseEastingNorthing: it is the
+    //    UTM false origin offset (e.g. +500 km East) and is NOT present in
+    //    either the StreetMap projected points or the XODR road positions.
+    TArray<FVector2D> PointsGlobalCm;
+    PointsGlobalCm.Reserve(NumPoints);
+    FVector2D CentroidGlobalCm(0, 0);
+    for (const FVector2D& Point : Building.BuildingPoints)
+    {
+      float GlobalEastingCm  = Point.X;  // Easting relative to LatLonOrigin (cm)
+      float GlobalSouthingCm = Point.Y;  // Southing relative to LatLonOrigin (cm)
+      PointsGlobalCm.Add(FVector2D(GlobalEastingCm, GlobalSouthingCm));
+      CentroidGlobalCm += FVector2D(GlobalEastingCm, GlobalSouthingCm);
+    }
+    CentroidGlobalCm /= NumPoints;
+
+    // 2. Get terrain height: GetHeight(Easting_m, -Northing_m) = GetHeight(X*0.01, Y*0.01)
+    float ZHeightM = GetHeight(CentroidGlobalCm.X * 0.01f, CentroidGlobalCm.Y * 0.01f, false);
+
+    // 3. Actor location: Unreal X = Easting (StreetMap.X), Unreal Y = -Northing (StreetMap.Y).
+    FVector ActorLocation(CentroidGlobalCm.X, CentroidGlobalCm.Y, ZHeightM * 100.0f);
+
+    // 4. Building height in CM
+    float BuildingHeightCm = Building.Height > 0 ? Building.Height : 300.0f;
+    if (Building.BuildingLevels > 0)
+    {
+      BuildingHeightCm = Building.BuildingLevels * 300.0f;
+    }
+
+    // 5. Relative polygon points (local to centroid): same axis order as absolute coords.
+    //    Local X = Easting_relative, Local Y = -Northing_relative
+    TArray<FVector2D> RelativePoints;
+    RelativePoints.Reserve(NumPoints);
+    for (const FVector2D& PG : PointsGlobalCm)
+    {
+      RelativePoints.Add(FVector2D(
+          PG.X - CentroidGlobalCm.X,    // local Unreal X: Easting relative to centroid
+          PG.Y - CentroidGlobalCm.Y));  // local Unreal Y: -Northing relative to centroid
+    }
+
+    // 6. Build extruded 3D mesh per section: walls, roof, floor
+    //    Each section has its own FProceduralCustomMesh so we can assign
+    //    different materials via CreateMultiSectionMesh.
+    FProceduralCustomMesh WallData;
+    FProceduralCustomMesh RoofData;
+    FProceduralCustomMesh FloorData;
+
+    // --- Wall geometry (section 0) ---
+    WallData.Vertices.Reserve(NumPoints * 4);
+    WallData.Normals.Reserve(NumPoints * 4);
+    WallData.UV0.Reserve(NumPoints * 4);
+    WallData.Triangles.Reserve(NumPoints * 6);
+
+    float Perimeter = 0.0f;
+    TArray<float> EdgeLengths;
+    EdgeLengths.Reserve(NumPoints);
+    for (int32 i = 0; i < NumPoints; ++i)
+    {
+      int32 Next = (i + 1) % NumPoints;
+      float Len = FVector2D::Distance(RelativePoints[i], RelativePoints[Next]);
+      EdgeLengths.Add(Len);
+      Perimeter += Len;
+    }
+    if (Perimeter < KINDA_SMALL_NUMBER) Perimeter = 1.0f;
+
+    float AccumulatedU = 0.0f;
+    for (int32 i = 0; i < NumPoints; ++i)
+    {
+      int32 Next = (i + 1) % NumPoints;
+      const FVector2D& P0 = RelativePoints[i];
+      const FVector2D& P1 = RelativePoints[Next];
+
+      float U0 = AccumulatedU / Perimeter;
+      AccumulatedU += EdgeLengths[i];
+      float U1 = AccumulatedU / Perimeter;
+
+      FVector2D EdgeDir = P1 - P0;
+      FVector WallNormal(EdgeDir.Y, -EdgeDir.X, 0.0f);
+      WallNormal.Normalize();
+
+      int32 BaseIdx = i * 4;
+      WallData.Vertices.Add(FVector(P0.X, P0.Y, 0.0f));              // BL
+      WallData.Vertices.Add(FVector(P1.X, P1.Y, 0.0f));              // BR
+      WallData.Vertices.Add(FVector(P0.X, P0.Y, BuildingHeightCm));  // TL
+      WallData.Vertices.Add(FVector(P1.X, P1.Y, BuildingHeightCm));  // TR
+
+      WallData.Normals.Add(WallNormal);
+      WallData.Normals.Add(WallNormal);
+      WallData.Normals.Add(WallNormal);
+      WallData.Normals.Add(WallNormal);
+
+      WallData.UV0.Add(FVector2D(U0, 1.0f));
+      WallData.UV0.Add(FVector2D(U1, 1.0f));
+      WallData.UV0.Add(FVector2D(U0, 0.0f));
+      WallData.UV0.Add(FVector2D(U1, 0.0f));
+
+      WallData.Triangles.Add(BaseIdx + 0);
+      WallData.Triangles.Add(BaseIdx + 2);
+      WallData.Triangles.Add(BaseIdx + 1);
+
+      WallData.Triangles.Add(BaseIdx + 1);
+      WallData.Triangles.Add(BaseIdx + 2);
+      WallData.Triangles.Add(BaseIdx + 3);
+    }
+
+    // --- Triangulate the polygon for roof/floor (handles concave shapes) ---
+    TArray<int32> TriTempIndices;
+    TArray<int32> TriangulatedVertexIndices;
+    bool bWindsClockwise = false;
+    bool bTriangulated = FPolygonTools::TriangulatePolygon(
+        RelativePoints, TriTempIndices, TriangulatedVertexIndices, bWindsClockwise);
+
+    // FPolygonTools::TriangulatePolygon internally reverses CCW polygons before
+    // triangulating. The returned indices reference that (possibly-reversed) vertex
+    // order. StreetMapComponent's working pattern is:
+    //   - Create roof vertices in REVERSED order relative to the original polygon
+    //   - Use the triangulation indices DIRECTLY (no remapping)
+    // This consistently produces upward-facing roof triangles regardless of original winding.
+
+    // --- Roof polygon (section 1) — vertices in REVERSED order ---
+    FVector RoofNormal(0, 0, 1.0f);
+    RoofData.Vertices.Reserve(NumPoints);
+    RoofData.Normals.Reserve(NumPoints);
+    RoofData.UV0.Reserve(NumPoints);
+    for (int32 i = 0; i < NumPoints; ++i)
+    {
+      const int32 RevIdx = (NumPoints - 1) - i;
+      RoofData.Vertices.Add(FVector(RelativePoints[RevIdx].X, RelativePoints[RevIdx].Y, BuildingHeightCm));
+      RoofData.Normals.Add(RoofNormal);
+      RoofData.UV0.Add(FVector2D(RelativePoints[RevIdx].X * 0.01f, RelativePoints[RevIdx].Y * 0.01f));
+    }
+    if (bTriangulated)
+    {
+      // Use indices directly — they match the reversed vertex order
+      RoofData.Triangles = TriangulatedVertexIndices;
+    }
+    else
+    {
+      for (int32 i = 1; i < NumPoints - 1; ++i)
+      {
+        RoofData.Triangles.Add(0);
+        RoofData.Triangles.Add(i);
+        RoofData.Triangles.Add(i + 1);
+      }
+    }
+
+    // --- Floor polygon (section 2) — vertices in ORIGINAL order, reversed winding ---
+    FVector FloorNormal(0, 0, -1.0f);
+    FloorData.Vertices.Reserve(NumPoints);
+    FloorData.Normals.Reserve(NumPoints);
+    FloorData.UV0.Reserve(NumPoints);
+    for (int32 i = 0; i < NumPoints; ++i)
+    {
+      FloorData.Vertices.Add(FVector(RelativePoints[i].X, RelativePoints[i].Y, 0.0f));
+      FloorData.Normals.Add(FloorNormal);
+      FloorData.UV0.Add(FVector2D(RelativePoints[i].X * 0.01f, RelativePoints[i].Y * 0.01f));
+    }
+    if (bTriangulated)
+    {
+      // Floor faces downward — use reversed vertices (same as roof) but flip winding
+      // so the face normal points -Z. Indices from triangulator + reversed vertex order
+      // gives upward face; swapping i1↔i2 flips it downward.
+      FloorData.Triangles.Reserve(TriangulatedVertexIndices.Num());
+      for (int32 i = 0; i < TriangulatedVertexIndices.Num(); i += 3)
+      {
+        // Remap from reversed-order indices back to original-order for floor vertices
+        int32 i0 = (NumPoints - 1) - TriangulatedVertexIndices[i];
+        int32 i1 = (NumPoints - 1) - TriangulatedVertexIndices[i + 1];
+        int32 i2 = (NumPoints - 1) - TriangulatedVertexIndices[i + 2];
+        FloorData.Triangles.Add(i0);
+        FloorData.Triangles.Add(i1);
+        FloorData.Triangles.Add(i2);
+      }
+    }
+    else
+    {
+      for (int32 i = 1; i < NumPoints - 1; ++i)
+      {
+        FloorData.Triangles.Add(0);
+        FloorData.Triangles.Add(i + 1);
+        FloorData.Triangles.Add(i);
+      }
+    }
+
+    // 7. Compute tangents per section
+    TArray<FProcMeshTangent> WallTangents, RoofTangents, FloorTangents;
+    UKismetProceduralMeshLibrary::CalculateTangentsForMesh(
+        WallData.Vertices, WallData.Triangles, WallData.UV0, WallData.Normals, WallTangents);
+    UKismetProceduralMeshLibrary::CalculateTangentsForMesh(
+        RoofData.Vertices, RoofData.Triangles, RoofData.UV0, RoofData.Normals, RoofTangents);
+    UKismetProceduralMeshLibrary::CalculateTangentsForMesh(
+        FloorData.Vertices, FloorData.Triangles, FloorData.UV0, FloorData.Normals, FloorTangents);
+
+    // Material assignment: walls → BuildingWallMaterial, roof → BuildingRoofMaterial, floor → wall material
+    UMaterialInstance* WallMat  = BuildingWallMaterial  ? BuildingWallMaterial  : DefaultSidewalksMaterial;
+    UMaterialInstance* RoofMat  = BuildingRoofMaterial  ? BuildingRoofMaterial  : DefaultSidewalksMaterial;
+    UMaterialInstance* FloorMat = WallMat;
+
+    TArray<FProceduralCustomMesh> Sections = { WallData, RoofData, FloorData };
+    TArray<TArray<FProcMeshTangent>> SectionTangents = { WallTangents, RoofTangents, FloorTangents };
+    TArray<UMaterialInstance*> SectionMaterials = { WallMat, RoofMat, FloorMat };
+
+    FName MeshName(*FString::Printf(TEXT("SM_Building_%d%s"), BuildingIndex, *GetStringForCurrentTile()));
+    UStaticMesh* BuildingMesh = UMapGenFunctionLibrary::CreateMultiSectionMesh(
+        Sections, SectionTangents, SectionMaterials, MapName, TEXT("Buildings"), MeshName, BaseDestinationPath);
+
+    FActorSpawnParameters SpawnParams;
+    SpawnParams.bNoFail = true;
+    SpawnParams.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+
+    if (BuildingMesh)
+    {
+      AStaticMeshActor* BuildingActor = World->SpawnActor<AStaticMeshActor>(
+          AStaticMeshActor::StaticClass(), ActorLocation, FRotator::ZeroRotator, SpawnParams);
+      if (BuildingActor)
+      {
+        BuildingActor->GetStaticMeshComponent()->SetStaticMesh(BuildingMesh);
+        BuildingActor->SetActorLabel(FString::Printf(TEXT("Building_%d%s"), BuildingIndex, *GetStringForCurrentTile()));
+        BuildingActor->Tags.Add(FName("Building"));
+        BuildingActor->GetStaticMeshComponent()->SetCollisionEnabled(ECollisionEnabled::QueryAndPhysics);
+        BuildingActor->SetActorEnableCollision(true);
+        BuildingActor->GetStaticMeshComponent()->CastShadow = true;
+
+        UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("Spawned building %d at (%f, %f, %f) height=%f m  nPts=%d"),
+            BuildingIndex, ActorLocation.X, ActorLocation.Y, ActorLocation.Z,
+            BuildingHeightCm * 0.01f, NumPoints);
+        ++GeneratedBuildingCount;
+      }
+    }
+    else
+    {
+      UE_LOG(LogCarlaToolsMapGenerator, Warning, TEXT("Failed to create mesh for building %d"), BuildingIndex);
+    }
+
+    BuildingIndex++;
+  }
+
+  UE_LOG(LogCarlaToolsMapGenerator, Log,
+      TEXT("Finished generating buildings: spawned=%d skipped_forest=%d total_spawned_so_far=%d"),
+      GeneratedBuildingCount, SkippedForestCount, BuildingIndex);
+}
+
+void UOpenDriveToMap::GenerateTreesFromOSM(UStreetMap* StreetMap, FVector MinLocation, FVector MaxLocation)
+{
+  if (!StreetMap)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateTreesFromOSM: null StreetMap"));
+    return;
+  }
+
+  const TArray<FStreetMapTree>& Trees = StreetMap->GetTrees();
+  const TArray<FStreetMapBuilding>& Buildings = StreetMap->GetBuildings();
+  UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("Generating %d trees from OSM"), Trees.Num());
+
+  UWorld* World = UEditorLevelLibrary::GetEditorWorld();
+  if (!World)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateTreesFromOSM: no editor world"));
+    return;
+  }
+
+  {
+    TArray<AActor*> ExistingActors;
+    UGameplayStatics::GetAllActorsOfClass(World, AActor::StaticClass(), ExistingActors);
+
+    int32 RemovedVegetationCount = 0;
+    for (AActor* ExistingActor : ExistingActors)
+    {
+      if (ExistingActor && ExistingActor->ActorHasTag(FName("Vegetation")))
+      {
+        World->EditorDestroyActor(ExistingActor, /*bShouldModifyLevel=*/true);
+        ++RemovedVegetationCount;
+      }
+    }
+
+    if (RemovedVegetationCount > 0)
+    {
+      UE_LOG(LogCarlaToolsMapGenerator, Log,
+          TEXT("GenerateTreesFromOSM: removed %d stale vegetation actors before regeneration"),
+          RemovedVegetationCount);
+    }
+  }
+
+  int32 TreeIndex = 0;
+
+  // Load a pool of tree/bush static meshes for random assignment
+  TArray<UStaticMesh*> TreeMeshPool;
+  {
+    const TCHAR* TreePaths[] = {
+      TEXT("/Game/Carla/Static/Vegetation/Trees/SM_Oak_M_v3.SM_Oak_M_v3"),
+      TEXT("/Game/Carla/Static/Vegetation/Trees/SM_Pine_Base_M_v7.SM_Pine_Base_M_v7"),
+      TEXT("/Game/Carla/Static/Vegetation/Trees/SM_Cypress.SM_Cypress"),
+      TEXT("/Game/Carla/Static/Vegetation/Trees/SM_Maple_M_v3.SM_Maple_M_v3"),
+      TEXT("/Game/Carla/Static/Vegetation/Trees/SM_Platanus02.SM_Platanus02"),
+    };
+    const TCHAR* BushPaths[] = {
+      TEXT("/Game/Carla/Static/Vegetation/Bushes/SM_Bush_L_v2.SM_Bush_L_v2"),
+      TEXT("/Game/Carla/Static/Vegetation/Bushes/SM_Cypress_Bush.SM_Cypress_Bush"),
+      TEXT("/Game/Carla/Static/Vegetation/Bushes/SM_Pine_Bush.SM_Pine_Bush"),
+    };
+    for (const TCHAR* Path : TreePaths)
+    {
+      UStaticMesh* M = LoadObject<UStaticMesh>(nullptr, Path);
+      if (M) TreeMeshPool.Add(M);
+    }
+    for (const TCHAR* Path : BushPaths)
+    {
+      UStaticMesh* M = LoadObject<UStaticMesh>(nullptr, Path);
+      if (M) TreeMeshPool.Add(M);
+    }
+    UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("Loaded %d vegetation meshes for random assignment"), TreeMeshPool.Num());
+  }
+  FRandomStream VegRNG(123); // separate RNG for mesh selection
+
+  auto SpawnTreeMarker = [&](const FVector& DesiredLocation, const TCHAR* LabelPrefix)
+  {
+    FTransform TreeTransform = GetSnappedPosition(FTransform(FRotator::ZeroRotator, DesiredLocation));
+
+    FActorSpawnParameters SpawnParams;
+    SpawnParams.bNoFail = true;
+    SpawnParams.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+
+    AStaticMeshActor* TreeActor = World->SpawnActor<AStaticMeshActor>(
+        AStaticMeshActor::StaticClass(),
+        TreeTransform.GetLocation(),
+        TreeTransform.Rotator(),
+        SpawnParams);
+
+    if (TreeActor)
+    {
+      TreeActor->SetActorLabel(FString::Printf(TEXT("%s%d%s"), LabelPrefix, TreeIndex, *GetStringForCurrentTile()));
+      TreeActor->Tags.Add(FName("TreeSpawnPosition"));
+      TreeActor->Tags.Add(FName("Vegetation"));
+
+      // Assign a random tree/bush mesh from the pool
+      if (TreeMeshPool.Num() > 0)
+      {
+        const int32 MeshIdx = VegRNG.RandRange(0, TreeMeshPool.Num() - 1);
+        TreeActor->GetStaticMeshComponent()->SetStaticMesh(TreeMeshPool[MeshIdx]);
+        // Random rotation around Z for visual variety
+        TreeActor->SetActorRotation(FRotator(0.0f, VegRNG.FRandRange(0.0f, 360.0f), 0.0f));
+      }
+
+      ++TreeIndex;
+      return true;
+    }
+
+    return false;
+  };
+
+  auto ConvertStreetMapPointToWorld = [&](const FVector2D& Point) -> FVector2D
+  {
+    // StreetMap.X = Easting_cm → Unreal X, StreetMap.Y = -Northing_cm → Unreal Y.
+    // Same convention as CARLA road geometry (Lane::ComputeTransform applies y*=-1).
+    // Direct pass-through: no swap.
+    return FVector2D(Point.X, Point.Y);
+  };
+
+  auto IsPointInsidePolygon = [](const FVector2D& Point, const TArray<FVector2D>& Polygon) -> bool
+  {
+    bool bInside = false;
+    const int32 NumPoints = Polygon.Num();
+    if (NumPoints < 3)
+    {
+      return false;
+    }
+
+    for (int32 i = 0, j = NumPoints - 1; i < NumPoints; j = i++)
+    {
+      const FVector2D& Pi = Polygon[i];
+      const FVector2D& Pj = Polygon[j];
+      const bool bIntersects = ((Pi.Y > Point.Y) != (Pj.Y > Point.Y)) &&
+          (Point.X < (Pj.X - Pi.X) * (Point.Y - Pi.Y) / ((Pj.Y - Pi.Y) + KINDA_SMALL_NUMBER) + Pi.X);
+      if (bIntersects)
+      {
+        bInside = !bInside;
+      }
+    }
+
+    return bInside;
+  };
+
+  // Road clearance threshold (cm) – reused for explicit OSM trees and open-space vegetation
+  const float RoadClearanceCm = FMath::Clamp(DistanceFromRoadEdge * 100.0f, 500.0f, 1500.0f);
+  const float RoadClearanceSq = RoadClearanceCm * RoadClearanceCm;
+
+  // Pre-build road segments for distance checking
+  const auto& Roads = StreetMap->GetRoads();
+  struct FRoadSegment { FVector2D A, B; };
+  TArray<FRoadSegment> RoadSegments;
+  for (const FStreetMapRoad& Road : Roads)
+  {
+    for (int32 i = 0; i < Road.RoadPoints.Num() - 1; ++i)
+    {
+      FVector2D A = ConvertStreetMapPointToWorld(Road.RoadPoints[i]);
+      FVector2D B = ConvertStreetMapPointToWorld(Road.RoadPoints[i + 1]);
+      RoadSegments.Add({A, B});
+    }
+  }
+
+  // Lambda: squared distance from point to line segment
+  auto PointToSegmentDistSq = [](const FVector2D& P, const FVector2D& A, const FVector2D& B) -> float
+  {
+    const FVector2D AB = B - A;
+    const float ABLenSq = AB.SizeSquared();
+    if (ABLenSq < KINDA_SMALL_NUMBER) return FVector2D::DistSquared(P, A);
+    const float T = FMath::Clamp(FVector2D::DotProduct(P - A, AB) / ABLenSq, 0.0f, 1.0f);
+    const FVector2D Closest = A + AB * T;
+    return FVector2D::DistSquared(P, Closest);
+  };
+
+  int32 OsmTreesSkipped = 0;
+  for (const FStreetMapTree& Tree : Trees)
+  {
+    const FVector2D WorldPoint = ConvertStreetMapPointToWorld(Tree.Location);
+
+    // Skip trees that are too close to any road
+    bool bNearRoad = false;
+    for (const FRoadSegment& Seg : RoadSegments)
+    {
+      if (PointToSegmentDistSq(WorldPoint, Seg.A, Seg.B) < RoadClearanceSq)
+      {
+        bNearRoad = true;
+        break;
+      }
+    }
+    if (bNearRoad)
+    {
+      ++OsmTreesSkipped;
+      continue;
+    }
+
+    const float ZHeightCm = GetHeight(WorldPoint.X * 0.01f, WorldPoint.Y * 0.01f, false) * 100.0f;
+    const FVector UnrealLocation(WorldPoint.X, WorldPoint.Y, ZHeightCm);
+
+    if (SpawnTreeMarker(UnrealLocation, TEXT("TreeSpawn_")))
+    {
+      UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("Spawned OSM tree %d at (%f, %f, %f)"),
+          TreeIndex - 1, UnrealLocation.X, UnrealLocation.Y, UnrealLocation.Z);
+    }
+  }
+  if (OsmTreesSkipped > 0)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("Skipped %d OSM trees that were too close to roads (clearance=%.0f cm)"),
+        OsmTreesSkipped, RoadClearanceCm);
+  }
+
+  int32 ForestAreaCount = 0;
+  int32 ForestTreeCount = 0;
+  const float TreeSpacingCm = FMath::Clamp(DistanceBetweenTrees * 100.0f, 800.0f, 2500.0f);
+
+  for (const FStreetMapBuilding& Building : Buildings)
+  {
+    if (!Building.BuildingCategory.Equals(TEXT("Forest"), ESearchCase::IgnoreCase) || Building.BuildingPoints.Num() < 3)
+    {
+      continue;
+    }
+
+    ++ForestAreaCount;
+
+    TArray<FVector2D> ForestPolygon;
+    ForestPolygon.Reserve(Building.BuildingPoints.Num());
+    FBox2D ForestBounds(EForceInit::ForceInitToZero);
+    for (const FVector2D& Point : Building.BuildingPoints)
+    {
+      const FVector2D WorldPoint = ConvertStreetMapPointToWorld(Point);
+      ForestPolygon.Add(WorldPoint);
+      ForestBounds += WorldPoint;
+    }
+
+    for (float X = ForestBounds.Min.X + (0.5f * TreeSpacingCm); X < ForestBounds.Max.X; X += TreeSpacingCm)
+    {
+      for (float Y = ForestBounds.Min.Y + (0.5f * TreeSpacingCm); Y < ForestBounds.Max.Y; Y += TreeSpacingCm)
+      {
+        const FVector2D Candidate(X, Y);
+        if (!IsPointInsidePolygon(Candidate, ForestPolygon))
+        {
+          continue;
+        }
+
+        const float ZHeightCm = GetHeight(Candidate.X * 0.01f, Candidate.Y * 0.01f, false) * 100.0f;
+        const FVector UnrealLocation(Candidate.X, Candidate.Y, ZHeightCm);
+        if (SpawnTreeMarker(UnrealLocation, TEXT("ForestTreeSpawn_")))
+        {
+          ++ForestTreeCount;
+        }
+      }
+    }
+  }
+
+  UE_LOG(LogCarlaToolsMapGenerator, Log,
+      TEXT("Finished generating trees: explicit=%d forest_areas=%d forest_tree_spawns=%d total_spawned_so_far=%d"),
+      Trees.Num(), ForestAreaCount, ForestTreeCount, TreeIndex);
+
+  // ---------------------------------------------------------------
+  // Random open-space vegetation: scatter trees & bushes in areas
+  // that are not occupied by buildings or too close to roads.
+  // ---------------------------------------------------------------
+  const float OpenSpacingCm = FMath::Clamp(DistanceBetweenTrees * 100.0f, 1500.0f, 5000.0f);
+  const float BuildingMarginCm = 300.0f; // 3 m clearance from building edges
+
+  // Pre-build building polygons in world coords for rejection testing
+  TArray<TArray<FVector2D>> BuildingPolygons;
+  BuildingPolygons.Reserve(Buildings.Num());
+  for (const FStreetMapBuilding& Building : Buildings)
+  {
+    if (Building.BuildingPoints.Num() < 3) continue;
+    TArray<FVector2D> Poly;
+    Poly.Reserve(Building.BuildingPoints.Num());
+    for (const FVector2D& Point : Building.BuildingPoints)
+    {
+      Poly.Add(ConvertStreetMapPointToWorld(Point));
+    }
+    BuildingPolygons.Add(MoveTemp(Poly));
+  }
+
+  // Map bounds in world coords
+  // MinLocation has the smallest coordinates, MaxLocation the largest.
+  // Y axis: MinLocation.Y is most negative (south), MaxLocation.Y is least negative (north).
+  const float MapMinX = MinLocation.X;
+  const float MapMaxX = MaxLocation.X;
+  const float MapMinY = MinLocation.Y;
+  const float MapMaxY = MaxLocation.Y;
+
+  FRandomStream RNG(42); // deterministic seed for reproducibility
+  int32 OpenSpaceTreeCount = 0;
+  int32 JunctionRejected = 0;
+  int32 XodrRejected = 0;
+  std::vector<::carla::geom::BoundingBox> JunctionBoxes;
+  if (CarlaMap.has_value())
+  {
+    JunctionBoxes = CarlaMap->GetJunctionsBoundingBoxes();
+  }
+
+  for (float GX = MapMinX + OpenSpacingCm * 0.5f; GX < MapMaxX; GX += OpenSpacingCm)
+  {
+    for (float GY = MapMinY + OpenSpacingCm * 0.5f; GY < MapMaxY; GY += OpenSpacingCm)
+    {
+      // Jitter the position randomly within the grid cell (natural look)
+      const float JitterX = RNG.FRandRange(-OpenSpacingCm * 0.4f, OpenSpacingCm * 0.4f);
+      const float JitterY = RNG.FRandRange(-OpenSpacingCm * 0.4f, OpenSpacingCm * 0.4f);
+      const FVector2D Candidate(GX + JitterX, GY + JitterY);
+
+      // Skip if too close to any road
+      bool bNearRoad = false;
+      for (const FRoadSegment& Seg : RoadSegments)
+      {
+        if (PointToSegmentDistSq(Candidate, Seg.A, Seg.B) < RoadClearanceSq)
+        {
+          bNearRoad = true;
+          break;
+        }
+      }
+      if (bNearRoad) continue;
+
+      // Skip if inside any building polygon (with margin)
+      bool bInsideBuilding = false;
+      for (const TArray<FVector2D>& Poly : BuildingPolygons)
+      {
+        if (IsPointInsidePolygon(Candidate, Poly))
+        {
+          bInsideBuilding = true;
+          break;
+        }
+      }
+      if (bInsideBuilding) continue;
+
+      // Random chance to skip ~40% of valid positions for natural density variation
+      if (RNG.FRand() < 0.4f) continue;
+
+      // Reject candidates inside junction areas first. This is stricter than
+      // nearest-lane queries and catches roundabout connector lanes even when
+      // they are too short for waypoint sampling to behave reliably.
+      // Then reject candidates that are on or too close to any other XODR
+      // driving lane.
+      // Candidate is already in the same absolute projected frame used by the
+      // StreetMap data and GetHeight (Easting_cm, -Northing_cm). Convert it
+      // directly to CARLA map meters here; do not subtract MinLocation.
+      if (CarlaMap.has_value())
+      {
+        const float XodrX = Candidate.X * 0.01f;
+        const float XodrY = Candidate.Y * 0.01f;
+        ::carla::geom::Location CarlaLoc(XodrX, XodrY, 0.0f);
+
+        constexpr float JunctionRejectBuffer = 2.0f;
+        bool bInsideJunction = false;
+        for (const auto& JunctionBox : JunctionBoxes)
+        {
+          if (CarlaLoc.x >= JunctionBox.location.x - JunctionBox.extent.x - JunctionRejectBuffer &&
+              CarlaLoc.x <= JunctionBox.location.x + JunctionBox.extent.x + JunctionRejectBuffer &&
+              CarlaLoc.y >= JunctionBox.location.y - JunctionBox.extent.y - JunctionRejectBuffer &&
+              CarlaLoc.y <= JunctionBox.location.y + JunctionBox.extent.y + JunctionRejectBuffer)
+          {
+            bInsideJunction = true;
+            break;
+          }
+        }
+        if (bInsideJunction)
+        {
+          ++JunctionRejected;
+          continue;
+        }
+
+        auto NearWP = CarlaMap->GetClosestWaypointOnRoad(CarlaLoc,
+            static_cast<int32_t>(::carla::road::Lane::LaneType::Driving));
+        if (NearWP.has_value())
+        {
+          ::carla::geom::Transform WPT = CarlaMap->ComputeTransform(*NearWP);
+          const float DX = CarlaLoc.x - WPT.location.x;
+          const float DY = CarlaLoc.y - WPT.location.y;
+          const float Dist2D = FMath::Sqrt(DX * DX + DY * DY);
+          const double LaneW = CarlaMap->GetLaneWidth(*NearWP);
+          // Reject if within lane + 3 m buffer (tree mesh radius)
+          if (Dist2D < static_cast<float>(LaneW * 0.5) + 3.0f)
+          {
+            ++XodrRejected;
+            continue;
+          }
+        }
+      }
+
+      const float ZHeightCm = GetHeight(Candidate.X * 0.01f, Candidate.Y * 0.01f, false) * 100.0f;
+      const FVector UnrealLocation(Candidate.X, Candidate.Y, ZHeightCm);
+      if (SpawnTreeMarker(UnrealLocation, TEXT("OpenSpaceVeg_")))
+      {
+        ++OpenSpaceTreeCount;
+      }
+    }
+  }
+
+  UE_LOG(LogCarlaToolsMapGenerator, Log,
+    TEXT("Open-space vegetation: spawned %d markers, rejected %d by junction boxes and %d by XODR lane check (spacing=%.0f cm, road_clearance=%.0f cm, junction_boxes=%d, MinLoc=(%.0f,%.0f))"),
+    OpenSpaceTreeCount, JunctionRejected, XodrRejected, OpenSpacingCm, RoadClearanceCm, JunctionBoxes.size(), MinLocation.X, MinLocation.Y);
+}
+
+void UOpenDriveToMap::GenerateTrafficSignals()
+{
+  UWorld* World = UEditorLevelLibrary::GetEditorWorld();
+
+  // 1. Get TrafficLightManager (it will be spawned if not present)
+  ATrafficLightManager* TLManager = nullptr;
+  AActor* TLManagerActor = UGameplayStatics::GetActorOfClass(World, ATrafficLightManager::StaticClass());
+  if (!TLManagerActor)
+  {
+    TLManager = World->SpawnActor<ATrafficLightManager>();
+  }
+  else
+  {
+    TLManager = Cast<ATrafficLightManager>(TLManagerActor);
+  }
+
+  if (TLManager)
+  {
+    if (CarlaMap.has_value())
+    {
+      UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("GenerateTrafficSignals: Providing local map with %d signals."), CarlaMap->GetSignals().size());
+      TLManager->SetMap(*CarlaMap);
+      TLManager->RemoveGeneratedSignalsAndTrafficLights();
+    }
+
+    TLManager->GenerateSignalsAndTrafficLights();
+    TLManager->AdjustAllSignsToHeightGround();
+
+    TArray<AActor*> SpawnedSigns;
+    UGameplayStatics::GetAllActorsOfClass(World, ATrafficSignBase::StaticClass(), SpawnedSigns);
+    UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("GenerateTrafficSignals: Found %d ATrafficSignBase actors in world after generation."), SpawnedSigns.Num());
+    for (AActor* Sign : SpawnedSigns)
+    {
+      UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("GenerateTrafficSignals: Found sign actor %s at %s"), *Sign->GetName(), *Sign->GetActorLocation().ToString());
+    }
+  }
+}
+
+void UOpenDriveToMap::GenerateOpenDriveData()
+{
+  UWorld* World = UEditorLevelLibrary::GetEditorWorld();
+  if (!World)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateOpenDriveData: Could not get editor world."));
+    return;
+  }
+
+  UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("GenerateOpenDriveData: Spawning AOpenDriveActor for map '%s'."), *MapName);
+
+  // Remove any existing OpenDriveActor to avoid duplicates
+  TArray<AActor*> ExistingActors;
+  UGameplayStatics::GetAllActorsOfClass(World, AOpenDriveActor::StaticClass(), ExistingActors);
+  for (AActor* A : ExistingActors)
+  {
+    A->Destroy();
+  }
+
+  AOpenDriveActor* OpenDriveActor = World->SpawnActor<AOpenDriveActor>(
+      AOpenDriveActor::StaticClass(), FTransform());
+
+  if (!OpenDriveActor)
+  {
+    UE_LOG(LogCarlaToolsMapGenerator, Error, TEXT("GenerateOpenDriveData: Failed to spawn AOpenDriveActor."));
+    return;
+  }
+
+  // Enable "Add Spawners" and "On Intersections" checkboxes
+  OpenDriveActor->SetAddSpawners(true);
+  OpenDriveActor->SetOnIntersections(true);
+
+  // Build the routes from the map's OpenDrive file ("Generate Routes")
+  OpenDriveActor->BuildRoutes(MapName);
+
+  // Add vehicle spawn points ("Add Spawners")
+  OpenDriveActor->AddSpawners();
+
+  UE_LOG(LogCarlaToolsMapGenerator, Log, TEXT("GenerateOpenDriveData: Done. %d route planners generated."),
+      OpenDriveActor->RoutePlanners.Num());
+
+  // Snap the editor camera to PlayerStart using native Editor "Snap View to Object"
+  TArray<AActor*> PlayerStarts;
+  UGameplayStatics::GetAllActorsOfClass(World, APlayerStart::StaticClass(), PlayerStarts);
+  if (PlayerStarts.Num() > 0 && PlayerStarts[0] && GEditor)
+  {
+    GEditor->MoveViewportCamerasToActor(*PlayerStarts[0], true);
+  }
+}
+
 #endif
