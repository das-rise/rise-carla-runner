+def set_reachable_destination(agent, spawn_points, start_location=None):
+    """
+    Try spawn points in a random order until a routable destination is found.
+    Needed for maps with disconnected road network components.
+    """
+    shuffled = list(spawn_points)
+    random.shuffle(shuffled)
+    # Get current orientation to avoid immediate U-turns
+    vehicle = agent._vehicle
+    forward_vec = vehicle.get_transform().get_forward_vector()
+    current_loc = start_location if start_location else vehicle.get_location()
+
+    for sp in shuffled:
+        # 1. Distance filter: avoid points that are too close (min 50m)
+        dist = current_loc.distance(sp.location)
+        if dist < 50.0:
+            continue
+
+        try:
+            # The agent will now internally check for U-turns and raise ValueError if detected
+            agent.set_destination(sp.location, start_location=start_location)
+            if hasattr(agent, "get_local_planner"):
+                plan = agent.get_local_planner().get_plan()
+                if len(plan) == 0:
+                    raise ValueError("Destination generated an empty route plan.")
+                dest = plan[-1][0].transform.location
+                print(
+                    "[DEST] Vehicle %d: destination set to (%.1f, %.1f, %.1f), "
+                    "plan length=%d"
+                    % (agent._vehicle.id, dest.x, dest.y, dest.z, len(plan))
+                )
+                return dest
+            print(
+                "[DEST] Vehicle %d: destination set to (%.1f, %.1f, %.1f)"
+                % (agent._vehicle.id, sp.location.x, sp.location.y, sp.location.z)
+            )
+            return sp.location
+        except (nx.NetworkXNoPath, ValueError) as e:
+            # Skip if no path or if the agent rejected the destination (e.g., U-turn)
+            continue
+    raise RuntimeError(
+        "No reachable destination found from current spawn point. "
+        "The map may have entirely disconnected road segments."
+    )
+
+
+def maybe_queue_next_destination(
+    agent,
+    actor,
+    spawn_points,
+    actor_label,
+    base_threshold_m=30.0,
+    min_plan_length=50,
+):
+    """
+    Append a new destination before the current route runs out to avoid stop-go
+    handoffs when roaming between missions.
+    """
+    if not hasattr(agent, "get_local_planner"):
+        return False
+
+    try:
+        local_planner = agent.get_local_planner()
+        plan = local_planner.get_plan()
+
+        if len(plan) == 0:
+            if hasattr(agent, "done") and agent.done():
+                print(
+                    "%s route is empty, assigning a recovery destination..."
+                    % actor_label
+                )
+                set_reachable_destination(
+                    agent, spawn_points, start_location=actor.get_location()
+                )
+                return True
+            return False
+
+        current_location = actor.get_location()
+        plan_end_location = plan[-1][0].transform.location
+        distance_to_plan_end = current_location.distance(plan_end_location)
+        speed_mps = actor.get_velocity().length()
+        preemptive_threshold = max(base_threshold_m, speed_mps * 3.0)
+
+        if distance_to_plan_end < preemptive_threshold and len(plan) < min_plan_length:
+            print(
+                "%s is %.1fm from the plan end, queuing the next destination..."
+                % (actor_label, distance_to_plan_end)
+            )
+            set_reachable_destination(
+                agent, spawn_points, start_location=plan_end_location
+            )
+            return True
+    except Exception as error:
+        print("Could not extend %s route: %s" % (actor_label, error))
+
+    return False
+
