+def resolve_spawn_point(spawn_points, index, description):
+    """Resolve a spawn-point index into a transform with bounds checking."""
+    if not spawn_points:
+        raise RuntimeError("There are no spawn points available in the current map.")
+    if index < 0 or index >= len(spawn_points):
+        raise ValueError(
+            "%s spawn point index %d is out of range. "
+            "Available indices: 0-%d" % (description, index, len(spawn_points) - 1)
+        )
+    return spawn_points[index]
+
