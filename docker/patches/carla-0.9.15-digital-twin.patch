+def create_npc_navigation_agent(sim_world, vehicle, args):
+    """Create a navigation agent for an NPC vehicle."""
+    if args.npc_agent == "Basic":
+        agent = BasicAgent(
+            vehicle, 30, opt_dict={"lateral_yield_distance": args.lateral_yield}
+        )
+        agent.follow_speed_limits(True)
+        return agent
+    if args.npc_agent == "Constant":
+        agent = ConstantVelocityAgent(vehicle, 30)
+        ground_loc = sim_world.ground_projection(vehicle.get_location(), 5)
+        if ground_loc:
+            vehicle.set_location(ground_loc.location + carla.Location(z=0.01))
+        agent.follow_speed_limits(True)
+        return agent
+    if args.npc_agent == "Behavior":
+        return BehaviorAgent(
+            vehicle,
+            behavior=args.npc_behavior,
+            opt_dict={"lateral_yield_distance": args.lateral_yield},
+        )
+    raise ValueError("Unsupported NPC agent type: %s" % args.npc_agent)
+
